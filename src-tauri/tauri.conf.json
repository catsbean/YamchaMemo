{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YamchaMemo",
  "version": "0.4.0",
  "identifier": "com.yamcha.memo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "YamchaMemo",
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "YamchaMemo",
    "copyright": "© 2026 YamchaMemo",
    "shortDescription": "마크다운 독서·글쓰기 메모",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Korean"],
        "installMode": "currentUser"
      }
    }
  }
}
